# ==========================================
# 1KAMPUS ENVIRONMENT CONFIGURATION
# ==========================================

# ------------------------------------------
# BACKEND API CONFIGURATION (apps/api)
# ------------------------------------------
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
API_PREFIX=/api/v1

# Supabase Database & Auth Configuration
# If Supabase credentials are provided, backend connects directly to Supabase PostgreSQL.
# In their absence, a high-fidelity local resilient in-memory store is used for seamless local development & testing.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Email Service Provider (Optional / Priority 2 Bonus)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=notifications@1kampus.local

# ------------------------------------------
# FRONTEND CONFIGURATION (apps/web)
# ------------------------------------------
VITE_API_BASE_URL=http://localhost:5000/api/v1
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
